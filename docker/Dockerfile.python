FROM python:3.12-slim@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 MPLCONFIGDIR=/tmp/matplotlib OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
COPY docker/python-requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir --require-hashes -r /tmp/requirements.txt && pip check
WORKDIR /work
COPY pyproject.toml ./
COPY scripts ./scripts
COPY tests ./tests
USER 65532:65532
CMD ["python", "-m", "pytest", "-q", "-p", "no:cacheprovider"]
